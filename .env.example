# Pluggable LLM Provider selection: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model configuration overrides
# Note: Gemini deprecates/overloads models frequently — check available models
# with `client.models.list()` if the default stops working.
# GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
# WHISPER_MODEL_SIZE=small

